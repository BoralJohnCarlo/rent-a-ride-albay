# Mock GPS Tracker Simulator - development only.
#
# 1. Register a tracker: POST /api/trackers (admin) -> copy the returned
#    imei + one-time deviceKey.
# 2. Assign it to a vehicle: PATCH /api/trackers/:id/assign.
# 3. Copy this file to `.env.simulator` in this same folder and fill in the
#    values below. Never commit `.env.simulator` itself.

MOCK_TRACKER_IMEI=
MOCK_TRACKER_KEY=
MOCK_VEHICLE_ID=
MOCK_VEHICLE_LABEL=Mock Vehicle
MOCK_API_BASE_URL=http://localhost:5000/api
MOCK_UPDATE_INTERVAL=5
MOCK_SCENARIO=moving

# Optional - deterministic overrides for alert testing only. Leave unset for
# normal simulator use; when set, they replace the scenario's own computed
# ignition/battery value for every tick.
# MOCK_IGNITION_OVERRIDE=true
# MOCK_BATTERY_OVERRIDE=15
